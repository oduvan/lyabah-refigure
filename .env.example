# Copy to `.env` on the server (placed by hand; never committed, never
# generated). Read by docker compose. Mode 600. This is the ONLY place
# per-service values are set.

SHARED_NETWORK=shared

# ── Identity ─────────────────────────────────────────────────────────────────
# SERVICE_NAME names the compose project + local image and labels the Traefik
# router. Lowercase, start with a letter, [a-z0-9-]. SERVICE_HOST is the public
# hostname Traefik serves this on (point its DNS A record at the server).
SERVICE_NAME=refigure
SERVICE_HOST=refigure.lyabah.com

# ── No database, no Redis, no mail ───────────────────────────────────────────
# The site is a stateless Go binary with the React build embedded: it stores
# nothing and sends no mail, so it owns no Postgres database and no Redis
# logical DB. `scripts/deploy.sh` skips provisioning while DB_NAME is unset —
# if this service ever needs a database, set DB_NAME, DB_ROLE, DB_PASSWORD and
# PG_ADMIN_USER/PG_ADMIN_PASSWORD here and the deploy will provision it.

# ── The release the download buttons point at ────────────────────────────────
# Every value is optional: leave one out and the binary's built-in default is
# used. Shipping a new desktop release is an edit here plus ./scripts/deploy.sh
# — no rebuild of the site.
REFIGURE_VERSION=1.0.0
REFIGURE_MAC_URL=https://github.com/oduvan/refigure/releases/download/v1.0.0/Refigure-1.0.0-universal.dmg
REFIGURE_MAC_SIZE=94 MB
REFIGURE_WINDOWS_URL=https://apps.microsoft.com/detail/refigure
REFIGURE_WINDOWS_SIZE=
REFIGURE_LINUX_URL=https://github.com/oduvan/refigure/releases/download/v1.0.0/Refigure-1.0.0-x86_64.AppImage
REFIGURE_LINUX_SIZE=108 MB

# ── Behaviour ────────────────────────────────────────────────────────────────
# Redirect any other hostname Traefik routes here to this one (301). Leave
# empty to serve whatever host asks.
REFIGURE_CANONICAL_HOST=refigure.lyabah.com
# debug | info | warn | error
LOG_LEVEL=info
