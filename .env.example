# Copy to `.env` on the server (placed by hand; never committed, never generated).
# Read by docker compose + the scripts. Mode 600. This is the ONLY place you set
# per-service values — the compose file and scripts read them from here, so nothing
# else needs editing when you create a service from the template.

SHARED_NETWORK=shared

# ── Identity ─────────────────────────────────────────────────────────────────
# SERVICE_NAME names the compose project + local image and labels the Traefik
# router. Lowercase, start with a letter, [a-z0-9-]. SERVICE_HOST is the public
# hostname Traefik serves this on (point its DNS A record at the server).
SERVICE_NAME=my-service
SERVICE_HOST=my-service.lyabah.com

# ── Shared Postgres ADMIN creds (from the infra .env) ────────────────────────
# Used ONLY by provision-db.sh to create this service's own DB + role — never
# injected into the app container.
PG_ADMIN_USER=provisioner
PG_ADMIN_PASSWORD=from-infra-env

# ── This service's OWN database + least-privilege role ───────────────────────
# Convention: the service name with hyphens -> underscores (Postgres-safe), e.g.
# my-service -> my_service. You choose the password.
DB_NAME=my_service
DB_ROLE=my_service
DB_PASSWORD=choose-a-strong-one

# ── Runtime connection strings injected into the app container ───────────────
# Keep the DB password in sync with DB_PASSWORD above. Pick a Redis logical DB
# number (0-15) that is unique across services. Avoid '$' (Compose interpolates
# it; if you must, double it to '$$').
DATABASE_URL=postgresql://my_service:choose-a-strong-one@postgres:5432/my_service
REDIS_URL=redis://:shared-redis-password@redis:6379/1

# ── Shared outbound mail (send-only; no auth on the shared network) ──────────
# SMTP_FROM should be under a domain listed in the infra's MAIL_SENDER_DOMAINS.
SMTP_URL=smtp://mail:587
SMTP_HOST=mail
SMTP_PORT=587
SMTP_FROM=my-service@lyabah.com
