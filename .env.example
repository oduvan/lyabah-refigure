# OPTIONAL. docker-compose.yml already defaults everything this service needs,
# so a deploy works with no `.env` at all. Create one on the server (by hand,
# mode 600, never committed) only to override something below.

# SHARED_NETWORK=shared

# ── Identity ─────────────────────────────────────────────────────────────────
# SERVICE_NAME names the compose project + local image and labels the Traefik
# router. SERVICE_HOST is the public hostname Traefik serves this on. Both
# default to the values shown; change them only for a fork on another host.
# SERVICE_NAME=refigure
# SERVICE_HOST=refigure.lyabah.com

# ── No database, no Redis, no mail ───────────────────────────────────────────
# The site is a stateless Go binary with the React build embedded: it stores
# nothing and sends no mail, so it owns no Postgres database and no Redis
# logical DB. `scripts/deploy.sh` skips provisioning while DB_NAME is unset —
# if this service ever needs a database, set DB_NAME, DB_ROLE, DB_PASSWORD and
# PG_ADMIN_USER/PG_ADMIN_PASSWORD here and the deploy will provision it.

# ── The release the download buttons point at ────────────────────────────────
# Normally nothing here. The site reads the latest GitHub release of
# REFIGURE_RELEASES_REPO and picks one asset per platform (.dmg, .exe,
# .AppImage), with the size taken from the asset itself — so publishing a
# release is the only step in shipping a new version.
# REFIGURE_RELEASES_REPO=oduvan/lyabah-refigure
# How often GitHub is asked. The answer is cached, and a failed refresh keeps
# serving the last good one.
# REFIGURE_RELEASES_TTL=15m
# Optional: only lifts GitHub's 60-requests-per-hour limit for anonymous
# callers. At the default TTL the site makes 4 requests an hour, so this is
# almost never needed.
# GITHUB_TOKEN=

# Overrides, for a platform that is NOT published as a GitHub release asset —
# a Microsoft Store listing, say. Anything set here wins over the release, and
# is also what the buttons show before GitHub has answered.
# REFIGURE_VERSION=1.0.0
# REFIGURE_WINDOWS_URL=https://apps.microsoft.com/detail/refigure
# REFIGURE_WINDOWS_SIZE=

# ── Behaviour ────────────────────────────────────────────────────────────────
# Redirect any other hostname Traefik routes here to this one (301). Leave
# empty to serve whatever host asks.
REFIGURE_CANONICAL_HOST=refigure.lyabah.com
# debug | info | warn | error
LOG_LEVEL=info
